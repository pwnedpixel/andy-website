{
  "name": "andy-website",
  "version": "0.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "ng serve",
    "ng": "ng",
    "build": "ng build --configuration production --base-href https://www.akeech.com/",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "github-deploy": "npm run build && angular-cli-ghpages --dir=dist --cname=www.akeech.com"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.2",
    "@angular/language-service": "22.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "angular-cli-ghpages": "^3.1.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  }
}
